# 1. DATABASE
DATABASE_URL=

# 2. APP URLS
NEXT_PUBLIC_URL="https://www.usa.truekinspection.com/"
NEXT_PUBLIC_APP_URL="https://www.usa.truekinspection.com/"

# 3. EMAIL (RESEND)
RESEND_API_KEY=
# Ops inbox for payment/report notifications (defaults to truekinspection@gmail.com)
OWNER_EMAIL=truekinspection@gmail.com
RESEND_EMAIL=

# 4. PayPal Development API credentials
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
PAYPAL_API_URL_PRODUCTION="https://api-m.paypal.com"
PAYPAL_API_URL_SANDBOX="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_SUCCESS_URL="https://carkinspection.com/payment-success"
NEXT_PUBLIC_CANCEL_URL="https://carkinspection.com/payment-cancel"

# 5. CLEARVIN API (v2.0 vendor REST)
# Environment switch:
#   CLEARVIN_ENV=test|production  (optional; defaults from NODE_ENV)
# Test / staging: static Bearer token — no login. Only approved test VINs work.
# Production: email/password login → JWT (120m), auto-refresh before expiry.
CLEARVIN_ENV=
CLEARVIN_TEST_TOKEN=
CLEARVIN_EMAIL=
CLEARVIN_PASSWORD=